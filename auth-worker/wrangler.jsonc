{
  "name": "jingyan-media-app",
  "main": "src/index.mjs",
  "compatibility_date": "2026-08-17",
  "workers_dev": true,

  "vars": {
    "COOKIE_NAME": "jy_session",
    "SESSION_TTL_DAYS": "180",
    "SESSION_REFRESH_HOURS": "24",
    "INVITE_DEFAULT_TTL_DAYS": "30",
    "PAIRING_TTL_MINUTES": "10",
    "RECOVERY_TTL_MINUTES": "30",
    "TURNSTILE_REQUIRED": "true",
    "TURNSTILE_REQUIRE_ACTION": "true",
    "TURNSTILE_EXPECTED_HOSTNAME": "jingyan-media-app.jingyancdn.workers.dev"
  },

  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "jingyan-media-auth",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],

  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "71401",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
