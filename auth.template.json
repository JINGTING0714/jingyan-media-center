{
  "system": "jingyan-media-auth",
  "version": "10.2",
  "mode": "invite-activation",
  "storage": {
    "provider": "cloudflare-d1",
    "database": "jingyan-media-auth"
  },
  "session": {
    "cookieName": "jy_session",
    "rollingDays": 180,
    "refreshHours": 24,
    "httpOnly": true,
    "secure": true,
    "sameSite": "Lax",
    "path": "/"
  },
  "invite": {
    "oneInviteOnePerson": true,
    "singleUse": true,
    "storePlaintextCode": false,
    "defaultExpiryDays": 30
  },
  "permissions": {
    "owner": {
      "uploadImage": true,
      "uploadAudio": true,
      "uploadVideo": true,
      "deleteMedia": true,
      "editMedia": true,
      "manageUsers": true,
      "manageInvites": true,
      "manageRepositories": true,
      "manageSystem": true,
      "runMaintenance": true
    },
    "uploader": {
      "uploadImage": true,
      "uploadAudio": true,
      "uploadVideo": true,
      "deleteMedia": false,
      "editMedia": false,
      "manageUsers": false,
      "manageInvites": false,
      "manageRepositories": false,
      "manageSystem": false,
      "runMaintenance": false
    }
  },
  "security": {
    "turnstile": true,
    "publicCodeRateLimit": "10/minute",
    "secretsStoredInRepository": false,
    "clientStoresPermissionsAsAuthority": false
  }
}
