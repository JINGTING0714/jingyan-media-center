{
  "system": "jingyan-media-center",

  "version": "3.0",

  "mode": "automatic",

  "cdn": {
    "provider": "jsdelivr",
    "enabled": true
  },

  "sources": {
    "image": {
      "repo": "JINGTING0714/jingyan-image-01",
      "json": "data/image.json"
    },

    "video": {
      "repo": "JINGTING0714/jingyan-video-01",
      "json": "data/video.json"
    },

    "music": {
      "repo": "JINGTING0714/jingyan-media-01",
      "json": "data/music.json"
    }
  },

  "automation": {
