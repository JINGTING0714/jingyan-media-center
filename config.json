{
  "system": "jingyan-media-center",
  "version": "6.0",
  "mode": "automatic",

  "github": {
    "api": "https://api.github.com",
    "autoCreateRepository": true,
    "private": false
  },


  "cdn": {
    "provider": "jsdelivr",
    "enabled": true
  },


  "database": {


    "image":
    "data/image.json",


    "audio":
    "data/music.json",


    "video":
    "data/video.json"


  },


  "limits": {

    "image": {
      "maxSizeMB": 15
    },

    "audio": {
      "maxSizeMB": 30
    },

    "video": {
      "maxSizeMB": 30
    }

  },


  "storage": {

    "maxRepositorySizeMB": 700,

    "autoSwitchRepository": true,


    "repositories": {


      "image": [

        {
          "id": "image-01",
          "repo": "JINGTING0714/jingyan-image-01",
          "branch": "main",
          "folder": "image",
          "database": "data/image.json",
          "sizeMB": 0
        }

      ],



      "audio": [

        {
          "id": "media-01",
          "repo": "JINGTING0714/jingyan-media-01",
          "branch": "main",
          "folder": "music",
          "database": "data/music.json",
          "sizeMB": 0
        }

      ],



      "video": [

        {
          "id": "video-01",
          "repo": "JINGTING0714/jingyan-video-01",
          "branch": "main",
          "folder": "video",
          "database": "data/video.json",
          "sizeMB": 0
        }

      ]

    }

  },



  "repositoryTemplate": {


    "image": {

      "prefix": "jingyan-image-",

      "startNumber": 1

    },


    "audio": {

      "prefix": "jingyan-media-",

      "startNumber": 1

    },


    "video": {

      "prefix": "jingyan-video-",

      "startNumber": 1

    }


  },



  "database": {


    "image": "data/image.json",

    "audio": "data/music.json",

    "video": "data/video.json"


  },



  "automation": {


    "upload": true,

    "rename": true,

    "generateID": true,

    "autoCreateRepository": true,

    "autoSwitchRepository": true,

    "updateDatabase": true,

    "generateCDN": true,

    "refreshCache": true


  }

}
