{
  "system": "jingyan-media-center",
  "version": "2.0",

  "owner": "JINGTING0714",

  "upload": {
    "enabled": true,

    "limits": {
      "image": "15MB",
      "audio": "30MB",
      "video": "30MB"
    },

    "allowedFormats": {

      "image": [
        "jpg",
        "jpeg",
        "png",
        "webp",
        "gif"
      ],

      "audio": [
        "mp3",
        "wav",
        "flac",
        "aac",
        "m4a"
      ],

      "video": [
        "mp4",
        "mov",
        "avi",
        "mkv"
      ]

    }
  },


  "storage": {

    "limit": "700MB",

    "autoSwitch": true,

    "mode": "automatic"

  },


  "repositories": {


    "image": {

      "current": "jingyan-image-01",

      "prefix": "jingyan-image-",

      "data": "data/image.json",

      "status": "data/status.json"

    },


    "music": {

      "current": "jingyan-media-01",

      "prefix": "jingyan-media-",

      "data": "data/music.json",

      "status": "data/status.json"

    },


    "video": {

      "current": "jingyan-video-01",

      "prefix": "jingyan-video-",

      "data": "data/video.json",

      "status": "data/status.json"

    }


  },


  "cdn": {

    "provider": "jsdelivr",

    "enabled": true

  }

}
