{
  "system": "jingyan-media-center",
  "version": "9.0",
  "mode": "automatic",

  "github": {
    "owner": "JINGTING0714",
    "private": false,
    "autoCreateRepository": true
  },

  "cdn": {
    "provider": "jsdelivr",
    "enabled": true,
    "includeBranch": true
  },

  "storage": {
    "targetRepositorySizeMB": 700,
    "overflowToleranceMB": 10,
    "autoSwitchRepository": true,

    "activeRepository": {
      "image": "image-01",
      "audio": "audio-01",
      "video": "video-01"
    },

    "repositories": {
      "image": [
        {
          "id": "image-01",
          "repo": "JINGTING0714/jingyan-image-01",
          "branch": "main",
          "folder": "image",
          "database": "data/image.json",
          "status": "data/status.json",
          "marker": "data/repository.json",
          "sizeMB": 0,
          "state": "active"
        }
      ],

      "audio": [
        {
          "id": "audio-01",
          "repo": "JINGTING0714/jingyan-media-01",
          "branch": "main",
          "folder": "music",
          "database": "data/music.json",
          "status": "data/status.json",
          "marker": "data/repository.json",
          "sizeMB": 8.397,
          "state": "active"
        }
      ],

      "video": [
        {
          "id": "video-01",
          "repo": "JINGTING0714/jingyan-video-01",
          "branch": "main",
          "folder": "video",
          "database": "data/video.json",
          "status": "data/status.json",
          "marker": "data/repository.json",
          "sizeMB": 0,
          "state": "active"
        }
      ]
    }
  },

  "mediaTypes": {
    "image": {
      "extensions": [
        "jpg",
        "jpeg",
        "png",
        "webp",
        "gif"
      ],
      "maxSizeMB": 15,
      "folder": "image",
      "database": "data/image.json",
      "status": "data/status.json",
      "marker": "data/repository.json",
      "idPrefix": "image",
      "repositoryPrefix": "jingyan-image-"
    },

    "audio": {
      "extensions": [
        "mp3",
        "wav",
        "flac",
        "aac"
      ],
      "maxSizeMB": 30,
      "folder": "music",
      "database": "data/music.json",
      "status": "data/status.json",
      "marker": "data/repository.json",
      "idPrefix": "music",
      "repositoryPrefix": "jingyan-media-"
    },

    "video": {
      "extensions": [
        "mp4",
        "webm"
      ],
      "maxSizeMB": 30,
      "folder": "video",
      "database": "data/video.json",
      "status": "data/status.json",
      "marker": "data/repository.json",
      "idPrefix": "video",
      "repositoryPrefix": "jingyan-video-"
    }
  },

  "counters": {
    "image": 0,
    "audio": 3,
    "video": 0
  },

  "rename": {
    "format": "number-name-extension",
    "numberDigits": 3
  },

  "upload": {
    "deduplicateByHash": true,
    "deleteTemporaryFile": true,
    "failOnUnsupported": true
  }
}
