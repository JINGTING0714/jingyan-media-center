{
  "system": "jingyan-media-center",
  "version": "1.0",

  "owner": "JINGTING0714",

  "repositories": {

    "music": [
      {
        "id": "music-01",
        "name": "jingyan-media-01",
        "type": "music",

        "capacity": {
          "limit": "700MB",
          "strategy": "manual-switch"
        },

        "cdn": "https://cdn.jsdelivr.net/gh/JINGTING0714/jingyan-media-01/",

        "folder": "music/",

        "data": "data/music.json",

        "status": "active"
      }
    ],


    "image": [
      {
        "id": "image-01",
        "name": "jingyan-image-01",
        "type": "image",

        "capacity": {
          "limit": "700MB",
          "strategy": "manual-switch"
        },

        "cdn": "https://cdn.jsdelivr.net/gh/JINGTING0714/jingyan-image-01/",

        "folder": "image/",

        "data": "data/image.json",

        "status": "active"
      }
    ],


    "video": [
      {
        "id": "video-01",
        "name": "jingyan-video-01",
        "type": "video",

        "capacity": {
          "limit": "700MB",
          "strategy": "manual-switch"
        },

        "cdn": "https://cdn.jsdelivr.net/gh/JINGTING0714/jingyan-video-01/",

        "folder": "video/",

        "data": "data/video.json",

        "status": "active"
      }
    ]

  },


  "fileRules": {

    "music": {
      "extensions": [
        "mp3",
        "wav",
        "flac",
        "m4a"
      ]
    },


    "image": {
      "extensions": [
        "jpg",
        "jpeg",
        "png",
        "webp",
        "gif"
      ]
    },


    "video": {
      "extensions": [
        "mp4",
        "webm",
        "mov"
      ]
    }

  },


  "upload": {

    "source": "upload",

    "autoGenerateUrl": true,

    "autoUpdateJson": true

  }

}
