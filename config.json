{
  "system": "jingyan-media-center",

  "version": "2.0",

  "owner": "JINGTING0714",

  "upload": {
    "enabled": true,

    "limits": {
      "image": "15MB",
      "audio": "30MB",
      "video": "30MB"
    },

    "allowedFormats": {
      "image": [
        "jpg",
        "jpeg",
        "png",
        "webp",
        "gif"
      ],

      "audio": [
        "mp3",
        "wav",
        "flac",
        "aac",
        "m4a"
      ],

      "video": [
        "mp4",
        "mov",
        "avi",
        "mkv"
      ]
    }
  },


  "repositories": {

    "image": {

      "id": "image-01",

      "name": "jingyan-image-01",

      "type": "image",

      "capacity": {

        "limit": "700MB",

        "allowOver": true,

        "strategy": "auto-switch"

      },

      "folder": "image/",

      "data": "data/image.json",

      "status": "active"

    },


    "video": {

      "id": "video-01",

      "name": "jingyan-video-01",

      "type": "video",

      "capacity": {

        "limit": "700MB",

        "allowOver": true,

        "strategy": "auto-switch"

      },

      "folder": "video/",

      "data": "data/video.json",

      "status": "active"

    },


    "music": {

      "id": "music-01",

      "name": "jingyan-media-01",

      "type": "music",

      "capacity": {

        "limit": "700MB",

        "allowOver": true,

        "strategy": "auto-switch"

      },

      "folder": "music/",

      "data": "data/music.json",

      "status": "active"

    }

  },


  "cdn": {

    "provider": "jsdelivr",

    "enabled": true

  },


  "automation": {

    "generateID": true,

    "generateJSON": true,

    "autoSwitchRepository": true,

    "updateStatus": true

  }

}
